{
  "name": "limbo",
  "private": true,
  "version": "1.4.11",
  "description": "A software manager with integrated browser, download manager, torrent client, and companion API for apps like Raffi",
  "type": "module",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "homepage": "https://limbo.kaleid.al",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:marketing": "tsc -p tsconfig.marketing.json && vite build --config vite.marketing.config.ts",
    "deploy:marketing": "bun run build:marketing && wrangler deploy",
    "generate-icons": "bunx tsx scripts/generate-icons.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:desktop": "sabine dev .",
    "build:desktop": "bun run build && cargo build --manifest-path desktop/Cargo.toml --release",
    "bundle:desktop": "sabine bundle . --release"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "flatted": "3.4.4"
  }
}
