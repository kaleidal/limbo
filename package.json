{
  "name": "limbo",
  "private": true,
  "version": "1.5.0",
  "description": "A software manager with integrated browser, download manager, torrent client, and companion API for apps like Raffi",
  "type": "module",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "homepage": "https://limbo.kaleid.al",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:marketing": "bun run check:marketing-worker && tsc -p tsconfig.marketing.json && vite build --config vite.marketing.config.ts",
    "deploy:marketing": "bun run build:marketing && wrangler deploy",
    "generate-icons": "bun scripts/generate-icons.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:desktop": "sabine dev .",
    "build:desktop": "bun run build && cargo build --manifest-path desktop/Cargo.toml --release",
    "bundle:desktop": "sabine bundle . --release",
    "check:marketing-worker": "wrangler types node_modules/.tmp/limbo-worker.d.ts && tsc -p tsconfig.marketing-worker.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@lantharos/sabine": "github:Lantharos/Sabine#v0.62",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
